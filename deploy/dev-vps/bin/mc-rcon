#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Minimal RCON client for the minecraft-dev container.

Usage: mc-rcon <command...>

Connects to 127.0.0.1:${MC_RCON_PORT:-25575}. The password comes from
RCON_PASSWORD in ${MC_RCON_ENV:-~/.config/minecraft-dev/rcon.env} (mode 0600)
and is never printed.
"""
import os, socket, struct, sys

HOST = os.environ.get("MC_RCON_HOST", "127.0.0.1")
PORT = int(os.environ.get("MC_RCON_PORT", "25575"))
ENV = os.environ.get("MC_RCON_ENV", os.path.expanduser("~/.config/minecraft-dev/rcon.env"))

def password():
    with open(ENV) as f:
        for line in f:
            if line.startswith("RCON_PASSWORD="):
                return line.split("=", 1)[1].strip()
    sys.exit("RCON_PASSWORD not found in env file")

def pkt(rid, typ, body):
    data = struct.pack("<ii", rid, typ) + body.encode() + b"\x00\x00"
    return struct.pack("<i", len(data)) + data

def recv(s):
    def exact(n):
        buf = b""
        while len(buf) < n:
            c = s.recv(n - len(buf))
            if not c:
                raise ConnectionError("connection closed")
            buf += c
        return buf
    (n,) = struct.unpack("<i", exact(4))
    buf = exact(n)
    rid, _typ = struct.unpack("<ii", buf[:8])
    return rid, buf[8:-2].decode(errors="replace")

def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd = " ".join(sys.argv[1:])
    try:
        with socket.create_connection((HOST, PORT), timeout=10) as s:
            s.sendall(pkt(1, 3, password()))
            rid, _ = recv(s)
            if rid == -1:
                sys.exit("rcon: authentication failed")
            s.sendall(pkt(2, 2, cmd))
            _, out = recv(s)
    except (OSError, ConnectionError) as e:
        sys.exit(f"rcon: {e}")
    if out:
        print(out)

if __name__ == "__main__":
    main()
