# Copy to ~mc/.config/minecraft-dev/rcon.env, chmod 600, and replace the value.
# Never commit the real file. The container entrypoint writes this into
# server.properties (rcon.password) and turns RCON on; mc-rcon reads it too.
# Generate one with:
#   head -c 32 /dev/urandom | base64 | tr -dc A-Za-z0-9 | head -c 32
RCON_PASSWORD=change-me
