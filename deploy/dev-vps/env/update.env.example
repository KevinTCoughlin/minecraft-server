# Optional. Copy to ~mc/.config/minecraft-dev/update.env (mode 0600).
# Read by mc-server-update.service and mc-plugin-update.service via
# EnvironmentFile=-, so the file may be absent. Every value below is the
# built-in default; uncomment only what you want to change.
#
# MC_UPDATE_REPO=KevinTCoughlin/minecraft-server
# MC_UPDATE_IMAGE=ghcr.io/kevintcoughlin/minecraft-server
# MC_UPDATE_MANUAL_RE=\[skip deploy\]|\[manual\]
# MC_PLUGIN_REPO=KevinTCoughlin/deathban-pro
# MC_UPDATE_START=0415      # update window, America/Los_Angeles, HHMM
# MC_UPDATE_DEADLINE=0755
# MC_BACKUP_KEEP=7
