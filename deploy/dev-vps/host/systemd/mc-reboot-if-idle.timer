# SPDX-License-Identifier: MIT
# 02:15, 02:35, 02:55, 03:15 America/Los_Angeles: after the nightly unattended
# upgrades, before mc-backup (03:30) and the 04:05-07:55 updater window.
# Persistent=false: a VPS that was off during the window does not reboot later.
[Unit]
Description=Check for an idle-time reboot (02:15 to 03:15 Pacific, every 20 minutes)

[Timer]
OnCalendar=*-*-* 02..03:15/20:00 America/Los_Angeles
RandomizedDelaySec=60
Persistent=false

[Install]
WantedBy=timers.target
