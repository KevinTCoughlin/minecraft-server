# SPDX-License-Identifier: MIT
# shellcheck shell=bash
# World "dad": ghcr.io/kevintcoughlin/mc-dad-server (Paper 26.3, Geyser/Floodgate,
# Parkour, WorldEdit, Multiverse). Image is pinned in its Quadlet and never
# auto-updated; the data dir is a full copy of the image's /minecraft.
MC_UNIT="${MC_UNIT:-minecraft-dad.service}"
MC_QUADLET="${MC_QUADLET:-${HOME}/.config/containers/systemd/minecraft-dad.container}"
MC_DATA="${MC_DATA:-${HOME}/minecraft-dad/data}"
MC_BACKUP_DIR="${MC_BACKUP_DIR:-${HOME}/backups/minecraft-dad}"
# Image-owned files; restore by re-seeding from the image (see REBUILD.md).
MC_BACKUP_EXCLUDES="${MC_BACKUP_EXCLUDES:-./server.jar ./app-cds.jsa}"
MC_CHUNKY="${MC_CHUNKY:-0}"
MC_UPDATES="${MC_UPDATES:-0}"
MC_WORLD_DESC="${MC_WORLD_DESC:-mc-dad-server image (Parkour, Multiverse, WorldEdit, Geyser)}"
