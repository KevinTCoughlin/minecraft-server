# SPDX-License-Identifier: MIT
# shellcheck shell=bash
# World "dev": the original Paper server (ghcr.io/kevintcoughlin/minecraft-server).
# Sourced by mc-lib.sh and mc-world (bash). Values are defaults; exported
# MC_* variables win, which the tests use.
MC_UNIT="${MC_UNIT:-minecraft-dev.service}"
MC_QUADLET="${MC_QUADLET:-${HOME}/.config/containers/systemd/minecraft-dev.container}"
MC_DATA="${MC_DATA:-${HOME}/minecraft-dev/data}"
MC_BACKUP_DIR="${MC_BACKUP_DIR:-${HOME}/backups/minecraft}"
MC_BACKUP_EXCLUDES="${MC_BACKUP_EXCLUDES:-}"
MC_CHUNKY="${MC_CHUNKY:-1}"      # Chunky idle timer applies to this world
MC_UPDATES="${MC_UPDATES:-1}"    # mc-server-update / mc-plugin-update apply to this world
MC_WORLD_DESC="${MC_WORLD_DESC:-Paper dev world (Chunky pre-gen, DeathBanPro, Xbox broadcast)}"
